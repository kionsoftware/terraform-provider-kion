func (r *{{.Recv}}Resource) ImportState(ctx context.Context, req resource.ImportStateRequest, resp *resource.ImportStateResponse) {
	importID := req.ID

	// Support prefixed import: "account_id=123" or "account_cache_id=123"
	var id int64
	var location string

	switch {
	case strings.HasPrefix(importID, "account_id="):
		raw := strings.TrimPrefix(importID, "account_id=")
		parsed, diags := framework.StringToInt64(raw)
		resp.Diagnostics.Append(diags...)
		if resp.Diagnostics.HasError() {
			return
		}
		id = parsed
		location = accounthelper.LocationProject

	case strings.HasPrefix(importID, "account_cache_id="):
		raw := strings.TrimPrefix(importID, "account_cache_id=")
		parsed, diags := framework.StringToInt64(raw)
		resp.Diagnostics.Append(diags...)
		if resp.Diagnostics.HasError() {
			return
		}
		id = parsed
		location = accounthelper.LocationCache

	default:
		// No prefix, auto-detect by trying both endpoints.
		parsed, diags := framework.StringToInt64(importID)
		resp.Diagnostics.Append(diags...)
		if resp.Diagnostics.HasError() {
			return
		}

		result, diags := accounthelper.ReadAccountForImport(ctx, r.Meta().Client, parsed)
		resp.Diagnostics.Append(diags...)
		if resp.Diagnostics.HasError() {
			return
		}
		id = parsed
		location = result.Location
	}

	resp.Diagnostics.Append(resp.State.SetAttribute(ctx, path.Root("id"), id)...)
	resp.Diagnostics.Append(resp.State.SetAttribute(ctx, path.Root("location"), location)...)
}

