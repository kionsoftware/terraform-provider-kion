	}
	configuredLabels := plan.{{.Labels.ModelGo}}
	if labelList != nil {
		labelOut, labelErr := conn.{{.Labels.Put}}(ctx, &{{.SDKAlias}}.AssociateLabels{
			Labels: {{.SDKAlias}}.OptNilAssociateLabelArray{Value: labelList, Set: true},
