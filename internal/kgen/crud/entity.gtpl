{{end}}func flatten{{.Pascal}}({{if or .HasRespSlices .HasNestedFlat .HasIDProj .RespRawValues}}ctx context.Context, {{end}}apiObject any, model *{{.Model}}) diag.Diagnostics {
	{{- if or .HasRespSlices .HasNestedFlat .HasIDProj .RespRawValues}}
	var diags diag.Diagnostics
	{{- end}}
	switch v := apiObject.(type) {
	case *{{.SDKAlias}}.{{.RespType}}:
		if v.Data{{if .RespDataPtr}} != nil{{else}}.Set{{end}} {
			{{- range .RespBinds}}
			{{- if .IsID}}
			if {{.IDSDKPath}}.Set {
				model.{{.ModelGo}} = types.StringValue({{if .IDFormatFunc}}strconv.{{.IDFormatFunc}}({{.IDSDKPath}}.Value, 10){{else}}{{.IDSDKPath}}.Value{{end}})
			}
			{{- else}}
			model.{{.ModelGo}} = {{.Converter}}({{.SDKPath}})
			{{- end}}
			{{- end}}
			{{- range .RespSliceBinds}}
			{{.Var}}, {{.Var}}Diags := {{.Func}}(ctx, {{.SDKPath}})
			diags.Append({{.Var}}Diags...)
			model.{{.ModelGo}} = {{.Var}}
			{{- end}}
			{{- range .RespObjFlats}}
			{{.Var}}, {{.Var}}Diags := New{{.ValueType}}({{.ValueType}}{}.AttributeTypes(ctx), map[string]attr.Value{
				{{- range .Subs}}
				"{{.TF}}": {{.Expr}},
				{{- end}}
			})
			diags.Append({{.Var}}Diags...)
			model.{{.ModelGo}} = {{.Var}}
			{{- end}}
			{{- range .RespArrFlats}}
			var {{.Var}}Elems []{{.ValueType}}
			for _, elem := range {{.SrcPath}} {
				{{.Var}}El, {{.Var}}D := New{{.ValueType}}({{.ValueType}}{}.AttributeTypes(ctx), map[string]attr.Value{
					{{- range .Subs}}
					"{{.TF}}": {{.Expr}},
					{{- end}}
				})
				diags.Append({{.Var}}D...)
				{{.Var}}Elems = append({{.Var}}Elems, {{.Var}}El)
			}
			{{.Var}}List, {{.Var}}LD := types.ListValueFrom(ctx, {{.ValueType}}{}.Type(ctx), {{.Var}}Elems)
			diags.Append({{.Var}}LD...)
			{{- if .OrderKey}}
			// list_order_keys: Kion returns these in an order of its own.
			{{.Var}}List, {{.Var}}LD = flex.OrderLikePrior(ctx, model.{{.ModelGo}}, {{.Var}}List, "{{.OrderKey}}")
			diags.Append({{.Var}}LD...)
			{{- end}}
			model.{{.ModelGo}} = {{.Var}}List
			{{- end}}
			{{- range .RespIDProjs}}
			{{- if .OrEmpty}}
			{{.Var}} := []int64{} // empty_collections: Kion returns none as null
			{{- else}}
			var {{.Var}} []int64
			{{- end}}
			for _, elem := range {{.SrcPath}} {
				{{- if .IDOpt}}
				if elem.{{.IDGo}}.Set {
					{{.Var}} = append({{.Var}}, {{.IDExpr}})
				}
				{{- else}}
				{{.Var}} = append({{.Var}}, {{.IDExpr}})
				{{- end}}
			}
			{{- if eq .Coll "Set"}}
			// A Set rejects duplicate elements, and the API does return an owner
			// twice on some records; three imports failed outright on this.
			{{.Var}} = flex.DedupeInt64({{.Var}})
			{{- end}}
			{{.Var}}Coll, {{.Var}}CD := types.{{.Coll}}ValueFrom(ctx, types.Int64Type, {{.Var}})
			diags.Append({{.Var}}CD...)
			{{- if not .OrEmpty}}
			// Kion returns an empty list as null; a configured [] stays empty.
			{{.Var}}Coll = flex.{{.Coll}}EmptyLikePrior(ctx, model.{{.ModelGo}}, {{.Var}}Coll)
			{{- end}}
			model.{{.ModelGo}} = {{.Var}}Coll
			{{- end}}
			{{- range .RespObjIDProjs}}
			{{- if .Opt}}
			if {{.SrcPath}}.Set {
				model.{{.ModelGo}} = types.Int64Value({{.IDExpr}})
			} else {
				model.{{.ModelGo}} = types.Int64Null()
			}
			{{- else}}
			model.{{.ModelGo}} = types.Int64Value({{.IDExpr}})
			{{- end}}
			{{- end}}
			{{- range .RespSums}}
			// The write took one {{.ModelGo}} and the server expanded it across the
			// rows below, which are all the read returns. An absent array is left
			// alone: "not reported" is not "zero", and zeroing breaks apply.
			if len({{.SrcPath}}) > 0 {
				var {{.Var}} float64
				for _, elem := range {{.SrcPath}} {
					{{.Var}} += {{.ElemExpr}}
				}
				model.{{.ModelGo}} = types.{{if .Round}}Int64Value(int64(math.Round({{.Var}}))){{else}}Float64Value({{.Var}}){{end}}
			}
			{{- end}}
			{{- range .RespRawValues}}
			diags.Append({{.Func}}(ctx, {{.SDKPath}}, model)...)
			{{- end}}
		}
		return {{if or .HasRespSlices .HasNestedFlat .HasIDProj .RespRawValues}}diags{{else}}nil{{end}}
	default:
		return errs.ResponseDiagnostics("reading "+{{.ResConst}}, apiObject)
	}
}
