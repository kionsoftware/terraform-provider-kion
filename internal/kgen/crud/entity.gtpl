	{{template "entityUpdateBody" .}}

	out, err := conn.{{.UpdateMethod}}(ctx, input, {{.SDKAlias}}.{{.UpdateParams}}{ {{.UpdateIDParam}}: {{.UpdateIDExpr}}})
